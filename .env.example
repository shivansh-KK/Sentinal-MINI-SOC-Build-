# ===============================================================================
# SENTINEL SOC — Environment Configuration Template
# Security Operations and Automated Incident Response Platform
# ===============================================================================
# Instructions: Copy this file to '.env' and adjust settings to match your environment.

# === APPLICATION & SERVER ===
APP_NAME="SENTINEL SOC"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# === DATABASE CONFIGURATION ===
# Default SQLite database (zero external dependencies, ideal for local development)
DATABASE_URL=sqlite:///./sentinel_soc.db

# Production PostgreSQL configuration (Uncomment to enable PostgreSQL)
# DATABASE_URL=postgresql://sentinel_user:sentinel_secure_pass@localhost:5432/sentinel_soc

# === JWT & AUTHENTICATION ===
# Cryptographically secure secret key for token signing (Minimum 32 characters in production)
SECRET_KEY=sentinel-soc-super-secret-jwt-key-for-capstone-demo-2026-replace-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# === CORS POLICY ===
# List of allowed HTTP origins permitted to communicate with backend APIs
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# === SOAR AUTOMATED RESPONSE ENGINE ===
# Operating Modes:
#   - simulation        : Generates actions, records audit logs, safe default (no OS modifications)
#   - approval_required : Requires human analyst sign-off before executing remediation
#   - lab_enforcement   : Auto-executes response rules strictly within RFC1918 private IP subnets
RESPONSE_MODE=simulation

# === WAZUH SIEM INTEGRATION (OPTIONAL) ===
# External Wazuh Manager API endpoint details
WAZUH_ENABLED=false
WAZUH_HOST=
WAZUH_PORT=55000
WAZUH_USER=wazuh
WAZUH_PASSWORD=
WAZUH_VERIFY_SSL=false

# === LOGGING & OBSERVABILITY ===
LOG_LEVEL=INFO
ENABLE_ACCESS_LOG=true

# === DEMO LAB MODE ===
# Enables synthetic event generation and sandbox attack vectors
DEMO_MODE=true
